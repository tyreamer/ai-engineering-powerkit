{
  "description": "AI Engineering PowerKit catastrophic-command guard. Stage and review the script before enabling.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.ai-powerkit/hooks/catastrophic_command_guard.py"
            ]
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PROJECT_DIR}/.ai-powerkit/hooks/catastrophic_command_guard.py"
            ]
          }
        ]
      }
    ]
  }
}
