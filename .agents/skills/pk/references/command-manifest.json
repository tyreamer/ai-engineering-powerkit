      "user_skill_root": ".agents/skills",
      "invocation": "/pk",
      "user_invocation": "ask Copilot to use the pk skill",
      "literal_slash": "supported-ide-surfaces",
      "project_prompt_source": "adapters/copilot/prompts/pk.prompt.md",
