{
  "schema_version": 1,
  "powerkit_version": "0.3.0",
  "repository": "https://github.com/tyreamer/ai-engineering-powerkit",
  "bootstrap": "BOOTSTRAP.md",
  "entrypoint": "powerkit",
  "commands": {
    "init": "powerkit init",
    "sync": "powerkit sync",
    "status": "powerkit status",
    "doctor": "powerkit doctor",
    "context_audit": "powerkit context audit",
    "update": "powerkit update",
    "uninstall": "powerkit uninstall"
  },
  "consumer_state": {
    "project": ".ai-powerkit/project.json",
    "installed": ".ai-powerkit/install-manifest.json"
  },
  "default_setup": {
    "profiles": [
      "all"
    ],
    "agents": true,
    "hooks_staged": false
  },
  "supported_platforms": [
    "codex",
    "claude",
    "copilot"
  ],
  "context_budgets": {
    "policy": "warn",
    "always_on_tokens": 900,
    "discovery_tokens": 2100,
    "fast_path_tokens": 8000,
    "standard_path_tokens": 12000,
    "deep_path_tokens": 15000,
    "regression_percent": 20,
    "regression_tokens": 250
  },
  "release": {
    "tag": "v0.3.0",
    "python": ">=3.11",
    "install": "pipx install git+https://github.com/tyreamer/ai-engineering-powerkit.git@v0.3.0"
  }
}
