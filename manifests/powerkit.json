{
  "schema_version": 1,
  "powerkit_version": "0.5.1",
  "repository": "https://github.com/tyreamer/ai-engineering-powerkit",
  "bootstrap": "BOOTSTRAP.md",
  "entrypoint": "powerkit",
  "commands": {
    "init": "powerkit init",
    "sync": "powerkit sync",
    "status": "powerkit status",
    "doctor": "powerkit doctor",
    "proof": "powerkit proof",
    "context_audit": "powerkit context audit",
    "broker": "powerkit broker",
    "certify": "powerkit certify",
    "update": "powerkit update",
    "uninstall": "powerkit uninstall"
  },
  "consumer_state": {
    "project": ".ai-powerkit/project.json",
    "installed": ".ai-powerkit/install-manifest.json",
    "proofs": ".ai-powerkit/proofs"
  },
  "schemas": {
    "proof_manifest": "schemas/proof-manifest.schema.json",
    "execution_broker": "schemas/execution-broker-v1.schema.json",
    "certification_cases": "schemas/certification-case-v1.schema.json",
    "certification_trace": "schemas/certification-trace-v1.schema.json",
    "certification_result": "schemas/certification-result-v1.schema.json"
  },
  "default_setup": {
    "profiles": [
      "all"
    ],
    "agents": true,
    "hooks_staged": false
  },
  "supported_platforms": [
    "codex",
    "claude",
    "copilot"
  ],
  "context_budgets": {
    "policy": "warn",
    "always_on_tokens": 900,
    "discovery_tokens": 2100,
    "fast_path_tokens": 8000,
    "standard_path_tokens": 12000,
    "deep_path_tokens": 15000,
    "regression_percent": 20,
    "regression_tokens": 250
  },
  "execution_policy": {
    "cost_preference": "BALANCED",
    "latency_preference": "BALANCED",
    "max_parallel_agents": 4,
    "allow_model_upgrade": true,
    "allow_network": "WHEN_REQUIRED",
    "high_risk_requires_checkpoint": true,
    "iteration_limits": {
      "FAST": 4,
      "STANDARD": 8,
      "DEEP": 16
    },
    "adapter_overrides": {}
  },
  "release": {
    "tag": "v0.5.1",
    "python": ">=3.11",
    "install": "pipx install git+https://github.com/tyreamer/ai-engineering-powerkit.git@v0.5.1"
  }
}
