{
  "schema_version": 1,
  "project_name": "replace-me",
  "powerkit": {
    "version": "0.4.0",
    "source": {
      "repository": "https://github.com/tyreamer/ai-engineering-powerkit",
      "version": "0.4.0",
      "ref": "v0.4.0"
    },
    "profiles": ["all"],
    "platforms": ["codex"],
    "agents": true,
    "hooks_staged": false,
    "context_budgets": {
      "policy": "warn",
      "always_on_tokens": 900,
      "discovery_tokens": 2100,
      "fast_path_tokens": 8000,
      "standard_path_tokens": 12000,
      "deep_path_tokens": 15000,
      "regression_percent": 20,
      "regression_tokens": 250
    }
  },
  "verification": {
    "static": [],
    "targeted": [],
    "broader": [],
    "runtime": []
  },
  "proof": {
    "output_directory": ".ai-powerkit/proofs"
  },
  "execution_policy": {
    "cost_preference": "BALANCED",
    "latency_preference": "BALANCED",
    "max_parallel_agents": 4,
    "allow_model_upgrade": true,
    "allow_network": "WHEN_REQUIRED",
    "high_risk_requires_checkpoint": true,
    "iteration_limits": {
      "FAST": 4,
      "STANDARD": 8,
      "DEEP": 16
    },
    "adapter_overrides": {}
  },
  "policy": {
    "ask_before_new_production_dependency": true,
    "single_writer_default": true,
    "require_runtime_proof_for_user_visible_changes": true
  }
}
